# ==============================================================================
# Spotify Connect Discord Bot Configuration
# ==============================================================================

# Discord Bot Credentials
# Get these from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# Optional: Discord Guild ID for fast slash-command development registration
# If omitted, commands are registered globally (takes up to ~1 hour to propagate)
DISCORD_GUILD_ID=

# Librespot Binary Configuration
# Path to the librespot executable (if in PATH, just "librespot")
LIBRESPOT_PATH=librespot

# Device name shown in the Spotify app (e.g. "Discord Voice - MyServer")
LIBRESPOT_DEVICE_NAME_PREFIX=Discord Voice

# Spotify Audio Bitrate: 96, 160, or 320 (kbps)
LIBRESPOT_BITRATE=160

# Initial Spotify Volume level (0 to 100)
LIBRESPOT_INITIAL_VOLUME=100

# Cache directory for Librespot credentials and session tokens
LIBRESPOT_CACHE_DIR=./cache/librespot

# Optional: Spotify Account Credentials (requires Spotify Premium)
# If provided, Librespot logs in automatically without requiring local mDNS discovery.
# If omitted, Librespot runs in Zeroconf discovery mode.
SPOTIFY_USERNAME=
SPOTIFY_PASSWORD=

# Enable Zeroconf / mDNS local discovery mode (true / false)
ENABLE_DISCOVERY=true

# Voice Channel Auto-Disconnect
# Number of seconds to wait before disconnecting if all users leave the voice channel
AUTO_DISCONNECT_EMPTY_TIMEOUT=60

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info
